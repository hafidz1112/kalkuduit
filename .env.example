# ==========================================================
# KONFIGURASI DATABASE TURSO (LIBSQL) & SERVER KALKUDUIT
# Salin file ini menjadi ".env" lalu isi nilai dari dashboard Turso
# ==========================================================

# 1. URL Database Turso (contoh: libsql://kalkuduit-username.turso.io atau https://...)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io

# 2. Auth Token Turso (turso db tokens create <nama-db>)
TURSO_AUTH_TOKEN=your-turso-auth-token

# 3. Port server produksi (npm run server)
PORT=3000
